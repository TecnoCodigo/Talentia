# ==========================================
# VARIABLES DE ENTORNO - SISTEMA AUTENTICACION P4
# ==========================================

# Servidor Backend
PORT=4000
NODE_ENV=development

# Base de Datos MySQL (Local / Docker)
DB_HOST=localhost
DB_PORT=3306
DB_USER=credenly_user
DB_PASSWORD=credenly_password
DB_NAME=sistema_autenticacion

# Secretos JWT para manejo seguro de sesiones
JWT_ACCESS_SECRET=supersecret_access_key_p4_2026
JWT_REFRESH_SECRET=supersecret_refresh_key_p4_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# URL del Frontend (CORS)
FRONTEND_URL=http://localhost:3000

# Integración con Google Gemini (Lectura de CVs con IA)
GEMINI_API_KEY=tu_api_key_de_google_gemini

# Almacenamiento en la Nube (Cloudflare R2 - Compatible S3)
R2_ACCOUNT_ID=tu_account_id_de_cloudflare
R2_ACCESS_KEY_ID=tu_access_key_r2
R2_SECRET_ACCESS_KEY=tu_secret_key_r2
R2_BUCKET_NAME=talentia-cvs
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
